#!/usr/bin/env python3
"""Executable shim for :mod:`client.ab`, for use from a checkout.

With this here, `git clone` plus `export PATH="$PWD/bin:$PATH"` is a working
client: `ab` and the two reporters import nothing outside the standard library,
so there is no install step to fail on a compute node with no network. The
gateway is the one thing `bin/` deliberately does not shim -- it needs FastAPI
and uvicorn, so a shim would promise something a bare clone cannot do.
"""
from __future__ import annotations

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from client.ab import main

if __name__ == "__main__":
    raise SystemExit(main())
