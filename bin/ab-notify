#!/usr/bin/env python3
"""ab-notify — a batch job reporting its own lifecycle back to the gateway.

Run from inside an sbatch script. The agent that submitted the job has long
since finished its turn; this is how the *work* says what it is doing.

    ab-notify --status running  --msg "vllm up, generating"
    ab-notify --status finished --report runs/swap-$SLURM_JOB_ID/SWAP.md
    ab-notify --status failed   --msg-file "$RUNS/error.txt"

Job id comes from $AB_JOB_ID, exported into the job:

    #SBATCH --export=ALL,AB_JOB_ID=<uuid>

Three write paths, tried in order. Whichever succeeds first wins; the message
is never silently lost.

  1. HTTP POST to the gateway   — immediate, and published to the event bus so
                                  SSE subscribers see it
  2. shared-filesystem JSONL    — for nodes that cannot reach the gateway;
                                  ingested lazily when someone reads the job
  3. local /tmp JSONL           — last resort. Deterministic path, printed on
                                  stderr, and in the same format as (2), so it
                                  can be moved into the shared dir later and
                                  ingested normally.

Batch jobs must not write the gateway's SQLite directly: it runs in WAL mode,
whose index is mmap'd shared memory and therefore requires every writer on the
same host. Appending short lines with O_APPEND needs no locking at all.

Stdlib only — compute nodes have no reliable outbound internet for installs.
"""
from __future__ import annotations

import argparse
import json
import os
import socket
import sys
import time
import urllib.error
import urllib.request

STATUSES = ("queued", "running", "finished", "failed")


def _data_dirs(data_dir: str | None):
    """Places to look for `.token` and `gateway-endpoint.json`."""
    for base in (data_dir, os.environ.get("AB_DATA_DIR"), os.getcwd()):
        if base:
            yield base


def _gateway_url(explicit: str | None, data_dir: str | None) -> tuple[str, str]:
    """(url, how) — where to POST, and where that came from.

    Never defaults to loopback. On a compute node `127.0.0.1` is that node, not
    the gateway, so a loopback default would fail on every call after burning a
    connect timeout. The gateway writes its own reachable address into the
    shared data dir at startup; that file is the discovery mechanism, and its
    absence (or a null url) means HTTP is genuinely unavailable — skip it fast.
    """
    if explicit:
        return explicit, "--url"
    if os.environ.get("AB_URL"):
        return os.environ["AB_URL"], "AB_URL"
    for base in _data_dirs(data_dir):
        p = os.path.join(base, "gateway-endpoint.json")
        try:
            with open(p, encoding="utf-8") as fh:
                info = json.load(fh)
        except (OSError, ValueError):
            continue
        if info.get("url"):
            return info["url"], f"{p}"
        return "", f"{p} says loopback-only"
    return "", "no --url, no AB_URL, no gateway-endpoint.json"


def _token(explicit: str | None, data_dir: str | None) -> str:
    if explicit:
        return explicit
    if os.environ.get("AB_TOKEN"):
        return os.environ["AB_TOKEN"]
    for base in _data_dirs(data_dir):
        p = os.path.join(base, ".token")
        try:
            with open(p, encoding="utf-8") as fh:
                return fh.read().strip()
        except OSError:
            continue
    return ""


def _append_jsonl(path: str, payload: dict) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    line = json.dumps(payload, separators=(",", ":")) + "\n"
    # O_APPEND: concurrent writers on a shared filesystem interleave whole
    # lines rather than corrupting each other. No locking needed.
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    try:
        os.write(fd, line.encode("utf-8"))
    finally:
        os.close(fd)


def _post(url: str, token: str, job_id: str, payload: dict, timeout: float) -> None:
    req = urllib.request.Request(
        f"{url.rstrip('/')}/v1/jobs/{job_id}/message",
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json",
                 "Authorization": f"Bearer {token}"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=timeout) as r:
        r.read()


def main() -> int:
    ap = argparse.ArgumentParser(prog="ab-notify")
    ap.add_argument("--status", required=True, choices=STATUSES)
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--msg", help="message text")
    g.add_argument("--msg-file", help="read message text from a file "
                                      "(avoids shell quoting for long text)")
    ap.add_argument("--report", help="path to the artifact a reader should open")
    ap.add_argument("--job-id", default=os.environ.get("AB_JOB_ID"))
    ap.add_argument("--url", help="gateway base URL; normally discovered from "
                                  "<data_dir>/gateway-endpoint.json")
    ap.add_argument("--token")
    ap.add_argument("--data-dir", default=os.environ.get("AB_DATA_DIR"))
    ap.add_argument("--messages-dir", default=os.environ.get("AB_MESSAGES_DIR"))
    ap.add_argument("--timeout", type=float, default=10.0)
    a = ap.parse_args()

    if not a.job_id:
        print("ab-notify: no job id (set AB_JOB_ID or pass --job-id)",
              file=sys.stderr)
        return 2

    msg = a.msg
    if a.msg_file:
        try:
            with open(a.msg_file, encoding="utf-8", errors="replace") as fh:
                msg = fh.read()[:16000]
        except OSError as e:
            print(f"ab-notify: cannot read --msg-file: {e}", file=sys.stderr)
            return 2

    payload = {
        "ts": time.time(),
        "status": a.status,
        "host": socket.gethostname(),
        "slurm_job_id": os.environ.get("SLURM_JOB_ID"),
    }
    if msg:
        payload["msg"] = msg
    if a.report:
        payload["report"] = os.path.abspath(a.report)

    errors = []

    # 1 — HTTP
    url, how = _gateway_url(a.url, a.data_dir)
    token = _token(a.token, a.data_dir)
    if url and token:
        try:
            _post(url, token, a.job_id, payload, a.timeout)
            print(f"ab-notify: sent via http ({a.status}) -> {url}")
            return 0
        except (urllib.error.URLError, OSError, ValueError) as e:
            errors.append(f"http {url}: {e}")
    elif not url:
        errors.append(f"http: no gateway url ({how})")
    else:
        errors.append("http: no token found")

    # 2 — shared filesystem
    shared = a.messages_dir or (
        os.path.join(a.data_dir, "messages") if a.data_dir else None)
    if shared:
        try:
            _append_jsonl(os.path.join(shared, f"{a.job_id}.jsonl"), payload)
            print(f"ab-notify: wrote shared jsonl ({a.status}) — {shared}")
            for e in errors:
                print(f"ab-notify: fell back, {e}", file=sys.stderr)
            return 0
        except OSError as e:
            errors.append(f"shared: {e}")
    else:
        errors.append("shared: no messages dir (set AB_MESSAGES_DIR or AB_DATA_DIR)")

    # 3 — local tmp, deterministic so it can be recovered by hand
    local = os.path.join(os.environ.get("TMPDIR", "/tmp"),
                         "agent-bridge-messages", f"{a.job_id}.jsonl")
    try:
        _append_jsonl(local, payload)
        print(f"ab-notify: WROTE LOCAL ONLY — {local}", file=sys.stderr)
        print("ab-notify: this node could not reach the gateway or shared "
              "store; move that file into <data_dir>/messages/ to have it "
              "ingested", file=sys.stderr)
        for e in errors:
            print(f"ab-notify: {e}", file=sys.stderr)
        return 0
    except OSError as e:
        errors.append(f"local: {e}")

    print("ab-notify: ALL WRITE PATHS FAILED", file=sys.stderr)
    for e in errors:
        print(f"  {e}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
