{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client", "node"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.tsx", "src/protocol.ts", "vite.config.ts"]
}
